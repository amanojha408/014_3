# ==============================================================================
# RoadSafe India 360 - Environment Configuration Template
# Copy this file to .env and provide your production credentials
# ==============================================================================

# --- Supabase Authentication & Database ---
# Obtain from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# --- CARTO Basemaps API Configuration ---
# Obtain from https://carto.com/developers/basemaps/
CARTO_API_KEY=your_carto_basemaps_api_key_here
VITE_CARTO_API_KEY=your_carto_basemaps_api_key_here

# --- Application Runtime & Server Settings ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
SECRET_KEY=your_secure_secret_key_here
VITE_API_BASE_URL=/api

# --- IBM Watson Machine Learning Service ---
# Endpoint URL, API key, Space ID, and Deployment identifiers for scoring & drift monitoring
IBM_WATSON_API_KEY=your_ibm_watson_api_key_here
IBM_WATSON_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSON_SPACE_ID=your_watson_space_id_here
IBM_WATSON_DEPLOYMENT_ID=your_watson_deployment_id_here
IBM_WATSON_PROJECT_ID=your_watson_project_id_here

# --- IBM Cloud Object Storage (COS) ---
# S3-compatible object storage for dashcam imagery, video clips, and Siamese audit evidence
IBM_COS_API_KEY=your_ibm_cos_api_key_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET_NAME=roadsafe-india-telemetry-bucket
IBM_COS_INSTANCE_CRN=your_cos_instance_crn_here

# --- MoRTH / NCRB Crash Data Gateway ---
MORTH_API_GATEWAY_URL=https://morth.nic.in/api/v1
MORTH_API_KEY=your_morth_api_key_here

# --- Computer Vision & Siamese Network Inference ---
SIAMESE_SIMILARITY_PASS_THRESHOLD=0.88
CV_DISPATCH_LATENCY_SLA_MS=500
